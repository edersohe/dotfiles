{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-coding-plan/MiniMax-M3",
  "small_model": "github-copilot/gpt-5-mini",
  "default_agent": "build",
  "share": "manual",
  "autoupdate": "notify",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.key": "deny",
      "**/secrets/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git rev-parse --abbrev-ref HEAD*": "allow",
      "git branch --show-current*": "allow",
      "git ls-files*": "allow",
      "git check-ignore*": "allow",
      "git push*": "deny",
      "git merge*": "deny",
      "git tag*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git rm*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -r*": "deny",
      "brew *": "deny",
      "snap *": "deny",
      "systemctl *": "deny",
      "service *": "deny",
      "ls *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "cd *": "allow",
      "cat *": "allow",
      "tree*": "allow",
      ">*": "deny",
      "ps *": "allow",
      "cd *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "find *": "allow",
      "touch *": "allow",
      "mkdir *": "allow"
    },
    "task": "ask",
    "webfetch": "ask",
    "websearch": "allow",
    "external_directory": {
      "*": "ask"
    },
    "lsp": "allow",
    "question": "allow",
    "todowrite": "allow",
    "doom_loop": "ask",
    "skill": "ask"
  }
}
